name = "bbosi-proxy"
main = "worker.mjs"
compatibility_date = "2026-09-04"

# Copie este arquivo para wrangler.toml antes de publicar.
# O arquivo real pode conter account_id/routes e nao precisa ser commitado.

[[d1_databases]]
binding = "DB"
database_name = "bbosi"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

[triggers]
crons = ["*/5 * * * *"]